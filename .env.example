# =============================================================================
# Quick LMS - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values
# Never commit .env.local or .env to version control!

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# Database (libsql/Turso)
# =============================================================================
# Local SQLite file (development)
DATABASE_URL=file:./local.db

# Remote Turso database (production)
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# =============================================================================
# Authentication
# =============================================================================
# JWT secret for session tokens (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# =============================================================================
# File Storage (S3-Compatible - iDrive e2)
# =============================================================================
# S3 Endpoint (without https://)
S3_ENDPOINT=x8r8.sg03.idrivee2-90.com

# S3 Region
S3_REGION=ap-southeast-1

# S3 Access Credentials
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# S3 Bucket Name
S3_BUCKET_NAME=lms

# S3 Public URL (optional, for CDN)
# S3_PUBLIC_URL=https://cdn.yourdomain.com

# Maximum file upload size (in bytes)
# 10MB = 10485760
# 50MB = 52428800
MAX_FILE_SIZE=52428800

# =============================================================================
# Email Service (Optional - for future use)
# =============================================================================
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxx

# =============================================================================
# External Services (Optional - for future use)
# =============================================================================
# Video Transcoding
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=

# Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Error Tracking
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# =============================================================================
# URLs
# =============================================================================
# Base URL for the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API URL (usually same as app URL)
NEXT_PUBLIC_API_URL=http://localhost:3000
